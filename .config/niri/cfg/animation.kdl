animations {
    // ─── СИНХРОНИЗИРОВАННАЯ ФИЗИКА (GOLDEN TRIO) ───
    // Идентичные параметры исключают микрофризы при одновременном сдвиге и ресайзе
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.001
    }

    // ─── НАВИГАЦИЯ И ОБЗОР ───
    // Вертикальное перемещение между воркспейсами
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.001
    }

    // Зум рабочего пространства в Mod+O Overview
    overview-open-close {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.001
    }

    // ─── ОКНА (БРУТАЛИЗМ: РЕЗКИЙ СТАРТ И МГНОВЕННОЕ ЗАТУХАНИЕ) ───
    // Ease-out-expo дает мгновенный скачок кадра на 165 Гц без нагрузки на iGPU
    window-open {
        duration-ms 130
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 110
        curve "ease-out-quad"
    }

    // ─── СИСТЕМНЫЙ ИНТЕРФЕЙС ───
    // Критическое затухание (damping 1.0) без желеобразного отскока
    config-notification-open-close {
        spring damping-ratio=1.0 stiffness=1100 epsilon=0.001
    }

    // Моментальный оверлей захвата экрана без задержки перед slurp
    screenshot-ui-open {
        duration-ms 80
        curve "ease-out-quad"
    }
}
