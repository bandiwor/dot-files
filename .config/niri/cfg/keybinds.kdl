binds {
    // ─── Системная справка ───
    Mod+Shift+Escape                    { show-hotkey-overlay; }

    // ─── Запуск приложений ───
    Mod+Return                          hotkey-overlay-title="Open Terminal: Kitty" { spawn "kitty"; }
    Mod+B                               hotkey-overlay-title="Open Browser: Firefox" { spawn "firefox"; }
    Mod+U                               hotkey-overlay-title="Open VPN: Happ" { spawn "happ"; }
    Mod+E                               hotkey-overlay-title="File Manager: Yazi (Foot)" { spawn "foot" "-e" "yazi"; }

    // ─── Системные хабы и меню ───
    Mod+R                               hotkey-overlay-title="App Launcher: Fuzzel" { spawn "fuzzel"; }
    Mod+T                               hotkey-overlay-title="Toggle Clock HUD" { spawn "killall" "-SIGUSR1" "waybar"; }
    Mod+P                               hotkey-overlay-title="Power & Battery Profile" { spawn "~/.config/niri/scripts/menu-power.sh"; }
    Mod+N                               hotkey-overlay-title="Wireless Hub (Wi-Fi / BT)" { spawn "~/.config/niri/scripts/menu-wireless.sh"; }
    Mod+I                               hotkey-overlay-title="Display & Brightness Hub" { spawn "~/.config/niri/scripts/menu-display.sh"; }
    Mod+Shift+I                         hotkey-overlay-title="Audio & Sink Manager" { spawn "~/.config/niri/scripts/menu-audio.sh"; }
    Mod+M                               hotkey-overlay-title="Session Menu" { spawn "~/.config/niri/scripts/menu-session.sh"; }
    Mod+Alt+L                           hotkey-overlay-title="Lock Screen" { spawn "hyprlock"; }

    Mod+Y       hotkey-overlay-title="Clipboard History" { spawn "~/.config/niri/scripts/clipboard.sh"; }
    Mod+Shift+Y hotkey-overlay-title="Clear Clipboard History" { spawn "~/.config/niri/scripts/clipboard.sh" "wipe"; }

    // ─── Аппаратные мультимедиа-клавиши ───
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "~/.config/niri/scripts/osd.sh" "vol-up"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "~/.config/niri/scripts/osd.sh" "vol-down"; }
    XF86AudioMute         allow-when-locked=true { spawn "~/.config/niri/scripts/osd.sh" "vol-mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "~/.config/niri/scripts/osd.sh" "mic-mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "~/.config/niri/scripts/osd.sh" "bright-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "~/.config/niri/scripts/osd.sh" "bright-down"; }

    XF86AudioNext         allow-when-locked=true { spawn "~/.config/niri/scripts/media.sh" "next"; }
    XF86AudioPrev         allow-when-locked=true { spawn "~/.config/niri/scripts/media.sh" "previous"; }
    XF86AudioPlay         allow-when-locked=true { spawn "~/.config/niri/scripts/media.sh" "play-pause"; }
    XF86AudioPause        allow-when-locked=true { spawn "~/.config/niri/scripts/media.sh" "play-pause"; }

    // ─── Управление окнами и фокусом ───
    Mod+Q                               { close-window; }

    Mod+Left                            { focus-column-left; }
    Mod+H                               { focus-column-left; }
    Mod+Right                           { focus-column-right; }
    Mod+L                               { focus-column-right; }
    Mod+Up                              { focus-window-up; }
    Mod+Down                            { focus-window-down; }

    Mod+K                               { focus-workspace-up; }
    Mod+J                               { focus-workspace-down; }

    Mod+Ctrl+Left                       { move-column-left; }
    Mod+Ctrl+H                          { move-column-left; }
    Mod+Ctrl+Right                      { move-column-right; }
    Mod+Ctrl+L                          { move-column-right; }
    Mod+Ctrl+Up                         { move-column-to-workspace-up; }
    Mod+Ctrl+K                          { move-column-to-workspace-up; }
    Mod+Ctrl+Down                       { move-column-to-workspace-down; }
    Mod+Ctrl+J                          { move-column-to-workspace-down; }

    Mod+Home                            { focus-column-first; }
    Mod+End                             { focus-column-last; }
    Mod+Ctrl+Home                       { move-column-to-first; }
    Mod+Ctrl+End                        { move-column-to-last; }

    // ─── Мультимониторность (HDMI-A-1 / eDP-1) ───
    Mod+Shift+Left                      { focus-monitor-left; }
    Mod+Shift+Right                     { focus-monitor-right; }
    Mod+Shift+Up                        { focus-monitor-up; }
    Mod+Shift+Down                      { focus-monitor-down; }

    Mod+Shift+Ctrl+Left                 { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right                { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up                   { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down                 { move-column-to-monitor-down; }

    // ─── Навигация колесом мыши ───
    Mod+WheelScrollDown                 cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp                   cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown            cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp              cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight                cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollLeft                 cooldown-ms=150 { focus-column-left; }
    Mod+Ctrl+WheelScrollRight           cooldown-ms=150 { move-column-right; }
    Mod+Ctrl+WheelScrollLeft            cooldown-ms=150 { move-column-left; }

    Mod+Shift+WheelScrollDown           cooldown-ms=150 { focus-column-right; }
    Mod+Shift+WheelScrollUp             cooldown-ms=150 { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown      cooldown-ms=150 { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp        cooldown-ms=150 { move-column-left; }

    // ─── Воркспейсы 1–9 ───
    Mod+1                               { focus-workspace 1; }
    Mod+2                               { focus-workspace 2; }
    Mod+3                               { focus-workspace 3; }
    Mod+4                               { focus-workspace 4; }
    Mod+5                               { focus-workspace 5; }
    Mod+6                               { focus-workspace 6; }
    Mod+7                               { focus-workspace 7; }
    Mod+8                               { focus-workspace 8; }
    Mod+9                               { focus-workspace 9; }

    Mod+Alt+1                           { move-column-to-workspace 1; }
    Mod+Alt+2                           { move-column-to-workspace 2; }
    Mod+Alt+3                           { move-column-to-workspace 3; }
    Mod+Alt+4                           { move-column-to-workspace 4; }
    Mod+Alt+5                           { move-column-to-workspace 5; }
    Mod+Alt+6                           { move-column-to-workspace 6; }
    Mod+Alt+7                           { move-column-to-workspace 7; }
    Mod+Alt+8                           { move-column-to-workspace 8; }
    Mod+Alt+9                           { move-column-to-workspace 9; }

    Mod+Tab                             { focus-workspace-previous; }

    // ─── Геометрия и размеры колонок ───
    // Циклическое переключение пресетов ширины (1/3 -> 1/2 -> 2/3)
    // Mod+Space                           { switch-preset-column-width; }
    // Mod+Shift+Space                     { switch-preset-window-height; }

    // Втягивание и выталкивание окон из колонки/стека
    Mod+BracketLeft                     { consume-or-expel-window-left; }
    Mod+BracketRight                    { consume-or-expel-window-right; }

    Mod+Alt+F                           { expand-column-to-available-width; }
    Mod+C                               { center-column; }
    Mod+Ctrl+C                          { center-visible-columns; }
    Mod+Minus                           { set-column-width "-10%"; }
    Mod+Equal                           { set-column-width "+10%"; }
    Mod+Shift+Minus                     { set-window-height "-10%"; }
    Mod+Shift+Equal                     { set-window-height "+10%"; }

    // ─── Режимы отображения ───
    Mod+V                               { toggle-window-floating; }
    Mod+F                               { fullscreen-window; }
    Mod+W                               { toggle-column-tabbed-display; }

    // ─── Скриншоты (без конфликтов с Ctrl+P) ───
    Print                               { spawn "~/.config/niri/scripts/screenshot.sh" "area"; }
    Shift+Print                         { spawn "~/.config/niri/scripts/screenshot.sh"; }

    // ─── Аварийный сброс захвата ввода (VM / RDP) ───
    Mod+Escape                          allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ─── Питание и сессия ───
    Ctrl+Alt+Delete                     { quit; }
    Mod+O                               repeat=false { toggle-overview; }
}
