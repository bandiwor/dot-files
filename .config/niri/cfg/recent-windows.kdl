recent-windows {
    // Задержка коммита окна в историю (мс): защищает список от случайных
    // промежуточных окон при быстром пролете ленты хоткеями Mod+H/L
    debounce-ms 750

    // Задержка показа UI (мс): при быстром одиночном тапе Alt+Tab переключение
    // происходит мгновенно вслепую, не моргая карточками на экране
    open-delay-ms 175

    // ─── РАМКА ВЫДЕЛЕНИЯ (FLAT-BRUTALISM) ───
    highlight {
        // Белая монохромная подложка активной карточки
        active-color "#ffffff30"
        urgent-color "#ffffff"

        // Отступ вокруг превью окна
        padding 20

        // Строгие прямые углы без скруглений
        corner-radius 0
    }

    // ─── РАЗМЕР ПРЕДПРОСМОТРА ───
    previews {
        // Ограничение высоты карточек под 1080p / 1200p экраны
        max-height 480
        max-scale 0.5
    }

    // ─── ПРИВЯЗКА КЛАВИШ ───
    binds {
        // Навигация по всем открытым окнам
        Alt+Tab         { next-window; }
        Alt+Shift+Tab   { previous-window; }

        // Навигация только внутри окон одного приложения (например, между окнами Kitty)
        Alt+grave       { next-window     filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}
