    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
    }

     // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }

    window-rule {
        match app-id="firefox" title="^Picture-in-Picture$"
        match app-id="firefox" title="^Картинка в картинке$"
        open-floating true
    }

    window-rule {
        match app-id="xdg-desktop-portal-gtk"
        match app-id="org.freedesktop.impl.portal.desktop.gtk"
        match title="^Open File$"
        match title="^Select a File$"
        match title="^Choose wallpaper$"
        open-floating true
    }
