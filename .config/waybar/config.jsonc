{
    "layer": "top",
    "position": "top",
    "exclusive": false,
    "passthrough": true,
    "modules-right": [
        "clock#time",
        "clock#date",
        "battery"
    ],
    "clock#time": {
        "format": "{:%H:%M}",
        "interval": 10,
        "tooltip": false
    },
    "clock#date": {
        "format": "{:%a %d.%m}",
        "interval": 60,
        "tooltip": false
    },
    "battery": {
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "<span foreground='#666666'>{icon}</span> {capacity}",
        "format-charging": "<span foreground='#666666'>󰂄</span> {capacity}",
        "format-plugged": "<span foreground='#666666'>󰚥</span> {capacity}",
        "format-full": "<span foreground='#666666'>󰁹</span> {capacity}",
        "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip": false
    }
}
